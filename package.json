{
  "name": "munhae-cat",
  "private": true,
  "version": "0.1.0",
  "description": "문해(文解) / Munhae CAT — 고한문 번역가를 위한 로컬 Electron CAT 도구",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --filter @munhae/desktop dev",
    "build": "pnpm -r --if-present build && pnpm --filter @munhae/desktop build",
    "dist": "pnpm --filter @munhae/desktop dist",
    "dist:mac:signed": "node scripts/release/build-macos.mjs",
    "pack": "pnpm --filter @munhae/desktop pack:dir",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "yaml": "^2.9.0"
  }
}
